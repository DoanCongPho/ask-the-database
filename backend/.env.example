# Any OpenAI-compatible provider. Examples:
#   OpenAI (default): LLM_BASE_URL empty, LLM_MODEL=gpt-4.1-mini (or gpt-4o-mini, gpt-5-mini)
#   Gemini:      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  LLM_MODEL=gemini-2.5-flash
#   Groq:        LLM_BASE_URL=https://api.groq.com/openai/v1                         LLM_MODEL=llama-3.3-70b-versatile
#   OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1
#   Ollama:      LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4.1-mini

# Read-only role from db/readonly_role.sql. Use port 5433 if you started Postgres with -p 5433:5432.
DATABASE_URL=postgresql://shop_reader:shop_reader@localhost:5432/shop

# Optional
# CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# MAX_ROWS=1000
# MAX_RETRIES=2
